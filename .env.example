# Microsoft Foundry project endpoint and model deployment name
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL=gpt-4o
# Hosted-agent samples also recognize this official quickstart variable.
# Leave it empty to reuse FOUNDRY_MODEL locally.
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Demo 00: Google Gemini Developer API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Demo 10: local OpenTelemetry console output
ENABLE_CONSOLE_EXPORTERS=true
ENABLE_SENSITIVE_DATA=false
OTEL_SERVICE_NAME=agent-framework-course-demos

# Demos 24: passwordless Blob access for the Hosted-agent identity lab
AZURE_STORAGE_ACCOUNT_URL=https://YOUR-STORAGE-ACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER_NAME=agent-framework-demos
AZURE_STORAGE_BLOB_NAME=travel-policy.txt

# Demo 12: Azure AI Search RAG
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net
AZURE_SEARCH_INDEX_NAME=YOUR-INDEX-NAME
# Optional. Leave empty to use AzureCliCredential for Search.
AZURE_SEARCH_API_KEY=

# Demos 20 and 21: agentic retrieval and identity-aware RAG
AZURE_OPENAI_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_SEARCH_AGENTIC_INDEX_NAME=travel-agentic-demo
AZURE_SEARCH_AGENTIC_KNOWLEDGE_SOURCE_NAME=travel-agentic-source
AZURE_SEARCH_AGENTIC_KNOWLEDGE_BASE_NAME=travel-agentic-kb
AZURE_SEARCH_SECURE_INDEX_NAME=travel-secure-demo
AZURE_SEARCH_SECURE_KNOWLEDGE_SOURCE_NAME=travel-secure-source
AZURE_SEARCH_SECURE_KNOWLEDGE_BASE_NAME=travel-secure-kb
# Optional real Entra group object ID for the finance-only sample documents.
DEMO_FINANCE_GROUP_OBJECT_ID=

# Demos 13 and 27: instructor-provided authenticated MCP server
MCP_SERVER_NAME=Contoso Change Risk Advisor
MCP_SERVER_URL=https://ca-copilot-dev-e925.redpond-16f6bb64.centralindia.azurecontainerapps.io/mcp
MCP_API_KEY=
